# =============================================================================
# Inova Auto — variáveis de ambiente (exemplo SEM valores reais)
# Copia para .env.local em desenvolvimento. Em Vercel, configura cada variável
# por ambiente (Development / Preview / Production) no painel do projeto.
# NUNCA uses o prefixo NEXT_PUBLIC_ para segredos: essas variáveis vão para o navegador.
# =============================================================================

# development | test | staging | production
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. Em Vercel: string do "Transaction pooler" da Supabase (porta 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inova_dev
DATABASE_POOL_MAX=5

# Autenticação dos colaboradores: supabase (obrigatório em produção) ou dev (só local)
AUTH_PROVIDER=dev
DEV_AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta Supabase — SÓ servidor. Usada para Storage. Nunca no navegador.
SUPABASE_SECRET_KEY=

# Ficheiros: supabase (produção) ou local (desenvolvimento)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# Base pública das fotografias quando STORAGE_DRIVER=local
NEXT_PUBLIC_STORAGE_PUBLIC_BASE=/media/vehicle-media

# Email transacional: resend | log (escreve na consola, só desenvolvimento) | disabled
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="Inova Auto <avisos@exemplo.pt>"
EMAIL_REPLY_TO=
# Destinatários internos de novos contactos (separados por vírgula)
STAFF_NOTIFICATION_EMAILS=

# WhatsApp Business Platform (Cloud API oficial): cloud_api | mock (só testes) | disabled
WHATSAPP_PROVIDER=disabled
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Versão explícita da Graph API (ex.: v23.0). Confirma a versão suportada antes de configurar.
WHATSAPP_GRAPH_API_VERSION=

# Fora de produção, mensagens reais só para estes destinatários (emails/telefones E.164)
OUTBOUND_ALLOWLIST=

# Segredo do processamento agendado (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Sal para identificadores de antiabuso (IPs nunca são guardados em claro)
RATE_LIMIT_SALT=

# Analítica opcional (só carrega após consentimento)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
